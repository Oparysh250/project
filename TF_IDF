# ===== TF-IDF АНАЛИЗ (для подбора категорий) =====

import re
import nltk
from sklearn.feature_extraction.text import TfidfVectorizer
from pymystem3 import Mystem
import os

# Скачиваем стоп-слова (если ещё не скачаны)
nltk.download('stopwords')
from nltk.corpus import stopwords

# ===== ЛЕММАТИЗАТОР =====
mystem = Mystem()
def lemmatize_text(text):
    lemmas = mystem.lemmatize(text)
    return ''.join(lemmas).strip()

# ===== ЗАГРУЗКА ДАННЫХ =====
folder = '/content/txt_data/'   # папка, куда ячейка 3 сохранила TXT-файлы
all_messages = []

for filename in os.listdir(folder):
    if filename.endswith('.txt'):
        file_path = os.path.join(folder, filename)
        with open(file_path, 'r', encoding='utf-8') as f:
            lines = f.readlines()
        for line in lines:
            text = line.strip()
            if text:
                all_messages.append(text)

print(f"📖 Загружено сообщений: {len(all_messages)}")

# ===== ОЧИСТКА, ЛЕММАТИЗАЦИЯ, ОТБОР ВОПРОСОВ =====
questions = []
for text in all_messages:
    # Приводим к нижнему регистру
    text = text.lower()
    # Оставляем только русские буквы и ?
    text = re.sub(r'[^а-яё\?]', ' ', text)
    text = ' '.join(text.split())
    # Оставляем только русские слова (и ?) и длину >= 3 слов
    words = text.split()
    russian_words = [w for w in words if re.search(r'[а-яА-Я?]', w)]
    if len(russian_words) >= 3 and '?' in text:
        clean_text = ' '.join(russian_words)
        lemmatized = lemmatize_text(clean_text)
        questions.append(lemmatized)

print(f"📊 Вопросов (после лемматизации): {len(questions)}")

# ===== СТОП-СЛОВА =====
russian_stopwords = stopwords.words('russian')

