russian_stopwords.extend(extra_stopwords)

# ===== TF-IDF =====
if len(questions) > 5:
    vectorizer = TfidfVectorizer(
        max_features=200,
        stop_words=russian_stopwords
    )
    tfidf_matrix = vectorizer.fit_transform(questions)
    feature_names = vectorizer.get_feature_names_out()
    word_importance = list(zip(feature_names, tfidf_matrix.sum(axis=0).tolist()[0]))
    word_importance.sort(key=lambda x: x[1], reverse=True)

    print("\n🎯 ТОП-200 ВАЖНЫХ СЛОВ (после стоп-слов и лемматизации):")
    print("-" * 60)
    for i, (word, weight) in enumerate(word_importance[:200], 1):
        count = sum(1 for q in questions if word in q.split())
        print(f"{i:3d}. {word:15} | вес: {weight:6.4f} | встречается: {count:4d} раз")

    # Вывод статистики по источникам
    print("\n📁 Статистика по папкам:")
    for filename in os.listdir(folder):
        if filename.endswith('.txt'):
            file_path = os.path.join(folder, filename)
            with open(file_path, 'r', encoding='utf-8') as f:
                lines = f.readlines()
            msg_count = len([l for l in lines if l.strip()])
            print(f"   {filename}: {msg_count} сообщений")

else:
    print("⚠️ Недостаточно вопросов для анализа.")
