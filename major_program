def convert_chats(input_file='student_questions.json', output_file='faq.json', min_frequency=2):
    print(f"🔄 Загружаем {input_file}...")
    with open(input_file, 'r', encoding='utf-8') as f:
        data = json.load(f)
    print(f"📖 Загружено записей: {len(data)}")

    # Фильтрация по частоте
    filtered = [item for item in data if item.get('frequency', 1) >= min_frequency]
    print(f"📊 После фильтрации (frequency >= {min_frequency}): {len(filtered)}")

    # Конвертация
    faq_entries = []
    skipped = 0
    new_id = 0
    for item in filtered:
        question = item.get('question', '')
        if not question:
            skipped += 1
            continue
        faq_entries.append({
            "id": new_id,
            "question": question,
            "answer": "None",
            "keywords": list(set(lemmatize_text(question).split()) & set(categories[categorize_question(lemmatize_text(question))])),
            "category": item.get('category'),
            "source": "chat_" + item.get('source', 'unknown')
        })
        new_id += 1

    print(f"✅ Конвертировано: {len(faq_entries)}")
    if skipped:
        print(f"⚠️ Пропущено (пустой вопрос): {skipped}")

    # === ДЕДУПЛИКАЦИЯ ===
    unique_entries, removed_count = deduplicate(faq_entries, threshold=85)
    print(f"🧹 Удалено дублей: {removed_count}")
    print(f"📊 Итоговое количество записей: {len(unique_entries)}")

    # Сохранение
    with open(output_file, 'w', encoding='utf-8') as f:
        json.dump(unique_entries, f, ensure_ascii=False, indent=2)

    print(f"💾 Сохранено в {output_file}")

    if unique_entries:
        print("\n📝 Пример первой записи:")
        print(json.dumps(unique_entries[0], ensure_ascii=False, indent=2))

    return unique_entries

